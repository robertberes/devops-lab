# Copy to .env for local development. Never commit the real .env file.

# PostgreSQL / backend database settings
DB_NAME=cmdb
DB_USER=cmdb
DB_PASSWORD=change-me-local-only

# Insert ~28 sample servers on first start when the table is empty (development only)
APP_SEED_ENABLED=true

# Host ports
FRONTEND_PORT=8082
BACKEND_PORT=8081
